# ─────────────────────────────────────────────────────────────
# EduGenie – Environment Configuration
# ─────────────────────────────────────────────────────────────

# AI Backend: "ollama" | "gemini" | "demo"
# Use "ollama" to run fully offline with a local Ollama model.
# Use "gemini" if you have a valid GEMINI_API_KEY.
# Use "demo" for static educational fallbacks (no AI needed).
AI_BACKEND=ollama

# ── Ollama (Local AI — default backend) ──────────────────────
OLLAMA_MODEL=qwen3:8b
OLLAMA_HOST=http://localhost:11434

# ── Google Gemini (optional — only used when AI_BACKEND=gemini)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
DEMO_MODE=false

# ── Database ──────────────────────────────────────────────────
DATABASE_URL=sqlite:///./edugenie.db

# ── Security ──────────────────────────────────────────────────
SECRET_KEY=change_this_secret_key_to_a_secure_random_string
